# Copy to .env and fill in. The .env file is gitignored.

# Database — leave blank for local SQLite dev (cadence.db in backend/).
# Production: Supabase connection string, e.g.
#   postgresql+psycopg://postgres:<pw>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# Anthropic — used by the decomposition + briefing services (Phase 2 / 7)
ANTHROPIC_API_KEY=

# Google Calendar — direct OAuth (Phase 4). Workspace-Internal app, no
# verification needed. Get these from console.cloud.google.com:
#   APIs & Services -> Credentials -> Create OAuth Client ID -> Web application.
# Redirect URI must match the route mounted in app/routers/oauth.py.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Slack incoming webhook (Phase 7) — optional, env-gated. Posts the daily
# briefing into one specific channel. Bot-level scopes not needed for that.
SLACK_WEBHOOK_URL=

# Expo push notifications (Phase 6) — server-side access token, scope: push.
EXPO_ACCESS_TOKEN=

# Scheduler coefficients (Section 5.1). Tweakable without code changes.
SCHED_ALPHA=1.0
SCHED_BETA=1.0
SCHED_GAMMA=0.5
SCHED_DELTA=0.7
