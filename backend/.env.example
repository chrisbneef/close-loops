# Copy to .env and fill in. The .env file is gitignored.

# Database — leave blank for local SQLite dev (cadence.db in backend/).
# Production: Supabase connection string, e.g.
#   postgresql+psycopg://postgres:<pw>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# Anthropic — used by the decomposition + briefing services (Phase 2 / 7)
ANTHROPIC_API_KEY=

# Google Calendar via MCP (Phase 4) — set both the URL and the auth header value.
# Pattern (verify against current docs before relying):
#   claude mcp add --transport http googlecalendar $GOOGLE_CALENDAR_MCP_URL \
#     --headers "X-API-Key:$COMPOSIO_API_KEY"
GOOGLE_CALENDAR_MCP_URL=
COMPOSIO_API_KEY=

# Outbound notification webhooks (Phase 7) — both optional, env-gated.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Expo push notifications (Phase 6) — server-side credentials.
EXPO_ACCESS_TOKEN=

# Scheduler coefficients (Section 5.1). Tweakable without code changes.
SCHED_ALPHA=1.0
SCHED_BETA=1.0
SCHED_GAMMA=0.5
SCHED_DELTA=0.7
