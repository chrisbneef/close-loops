{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Close Your Loops",
  "version": "0.1.0",
  "identifier": "com.closeyourloops.widget",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "title": "Close Your Loops",
        "url": "https://closedloops.tech/widget",
        "width": 400,
        "height": 640,
        "minWidth": 300,
        "minHeight": 220,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": true,
        "center": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
